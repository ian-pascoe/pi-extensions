{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "envMode": "loose",
  "globalDependencies": ["mise.toml", "tsconfig.json", "vitest.config.ts"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "@ian-pascoe/pi-advisor#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pi-context-management/**",
        "$TURBO_ROOT$/packages/pi-minimal-subagents/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "@ian-pascoe/pi-advisor#typecheck": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pi-context-management/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "@ian-pascoe/pi-command-deck#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pi-minimal-subagents/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "@ian-pascoe/pi-context-management#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pi-todo/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "@ian-pascoe/pi-dap#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.pi/settings.json"]
    },
    "@ian-pascoe/pi-lsp#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pi-dap/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "@ian-pascoe/pi-minimal-subagents#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pi-context-management/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "@ian-pascoe/pi-termctrl#test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/pi-minimal-subagents/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "//#test:root": {
      "inputs": [
        "test/**",
        "vitest.config.ts",
        "package.json",
        "pnpm-lock.yaml",
        "packages/pi-formatter/**",
        "packages/pi-lsp/**",
        "packages/pi-utils/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "//#typecheck:root": {
      "inputs": ["scripts/**/*.mjs", "test/**/*.ts", "vitest.config.ts"]
    },
    "//#format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/**",
        "tools/**",
        ".oxfmtrc.json",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!**/coverage/**",
        "!**/*.tgz",
        "!.pi/**",
        "!.repos/**",
        "!.scratch/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    },
    "//#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/**",
        "tools/**",
        ".oxlintrc.json",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!**/coverage/**",
        "!**/*.tgz",
        "!.pi/**",
        "!.repos/**",
        "!.scratch/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**"
      ]
    }
  }
}
