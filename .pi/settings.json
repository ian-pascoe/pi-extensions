  "mcp": {
    "servers": {}
  },
  "formatter": {
    "formatters": {
      "oxfmt": {
        "command": "pnpm",
        "args": [
          "exec",
          "oxfmt",
          "--no-error-on-unmatched-pattern",
          "$FILE"
        ],
        "files": {
          "extensions": [
            ".js",
            ".jsx",
            ".ts",
            ".tsx",
            ".mjs",
            ".cjs",
            ".mts",
            ".cts",
            ".json",
            ".jsonc",
            ".md",
            ".yml",
            ".yaml",
            ".css"
          ]
        },
        "rootMarkers": [
          ".oxfmtrc.json"
        ],
        "requireRootMarker": true
      }
    }
  },
  "dap": {
    "adapters": {
      "node": {
        "command": "node",
        "args": [
          "packages/pi-dap/node_modules/vscode-js-debug/src/dapDebugServer.js",
          "$PORT",
          "127.0.0.1"
        ],
        "environment": {},
        "transport": {
          "type": "tcp",
          "host": "127.0.0.1",
          "port": 0
        }
      }
    },
    "profiles": {
      "node": {
        "adapter": "node",
        "arguments": {
          "type": "pwa-node",
          "console": "internalConsole",
          "stopOnEntry": true
        }
      }
    }
  },
  "lsp": {
    "servers": {
      "typescript": {
        "command": "pnpm",
        "args": ["--workspace-root", "exec", "tsc", "--lsp", "--stdio"],
        "languages": [
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": [
          "tsconfig.json"
        ],
        "requireRootMarker": true
      },
      "oxlint": {
        "command": "pnpm",
        "args": [
          "exec",
          "oxlint",
          "--lsp"
        ],
        "languages": [
          {
            "extensions": [
              ".js",
              ".mjs",
              ".cjs"
            ],
            "languageId": "javascript"
          },
          {
            "extensions": [
              ".jsx"
            ],
            "languageId": "javascriptreact"
          },
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": [
          ".oxlintrc.json"
        ],
        "requireRootMarker": true
      }
    }
  }
}
