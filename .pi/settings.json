{
  "packages": [
    {
      "source": "..",
      "autoload": false,
      "extensions": [
        "-packages/pi-adaptive-thinking/src/index.ts",
        "+packages/pi-bible-verses/src/index.ts",
        "-packages/pi-byterover/src/index.ts",
        "+packages/pi-git-status-widget/src/index.ts",
        "+packages/pi-formatter/src/index.ts",
        "+packages/pi-lsp/src/index.ts",
        "+packages/pi-minimal-subagents/src/index.ts",
        "+packages/pi-tps-tracker/src/index.ts"
      ]
    },
    {
      "source": "git:github.com/ian-pascoe/pi-extensions",
      "autoload": false,
      "extensions": [
        "-packages/pi-adaptive-thinking/src/index.ts",
        "-packages/pi-bible-verses/src/index.ts",
        "-packages/pi-byterover/src/index.ts",
        "-packages/pi-git-status-widget/src/index.ts",
        "-packages/pi-formatter/src/index.ts",
        "-packages/pi-lsp/src/index.ts",
        "-packages/pi-minimal-subagents/src/index.ts",
        "-packages/pi-tps-tracker/src/index.ts"
      ]
    }
  ],
  "formatter": {
    "formatters": {
      "oxfmt": {
        "command": "pnpm",
        "args": [
          "exec",
          "oxfmt",
          "--config=.oxfmtrc.json",
          "--no-error-on-unmatched-pattern",
          "$FILE"
        ],
        "files": {
          "extensions": [
            ".js",
            ".jsx",
            ".ts",
            ".tsx",
            ".mjs",
            ".cjs",
            ".mts",
            ".cts",
            ".json",
            ".jsonc",
            ".md",
            ".yml",
            ".yaml",
            ".css",
            ".astro"
          ]
        },
        "requireRootMarker": true,
        "rootMarkers": [".oxfmtrc.json"]
      }
    }
  },
  "lsp": {
    "servers": {
      "typescript": {
        "command": "pnpm",
        "args": ["exec", "tsc", "--lsp", "--stdio"],
        "languages": [
          {
            "extensions": [".ts", ".mts", ".cts"],
            "languageId": "typescript"
          },
          {
            "extensions": [".tsx"],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": ["tsconfig.json", "package.json", ".git"]
      },
      "oxlint": {
        "command": "pnpm",
        "args": ["exec", "oxlint", "--lsp"],
        "languages": [
          {
            "extensions": [".js", ".mjs", ".cjs"],
            "languageId": "javascript"
          },
          {
            "extensions": [".jsx"],
            "languageId": "javascriptreact"
          },
          {
            "extensions": [".ts", ".mts", ".cts"],
            "languageId": "typescript"
          },
          {
            "extensions": [".tsx"],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": ["package.json", ".git"]
      }
    }
  }
}
