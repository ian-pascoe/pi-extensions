{
  "packages": [
    {
      "source": "..",
      "autoload": false,
      "extensions": [
        "-packages/pi-adaptive-thinking/src/index.ts",
        "+packages/pi-bible-verses/src/index.ts",
        "-packages/pi-byterover/src/index.ts",
        "+packages/pi-dap/src/index.ts",
        "+packages/pi-formatter/src/index.ts",
        "+packages/pi-git-checkpoints/src/index.ts",
        "+packages/pi-git-status-widget/src/index.ts",
        "+packages/pi-lsp/src/index.ts",
        "+packages/pi-minimal-subagents/src/index.ts",
        "+packages/pi-tps-tracker/src/index.ts"
      ]
    },
    {
      "source": "git:github.com/ian-pascoe/pi-extensions",
      "autoload": false,
      "extensions": [
        "-packages/pi-adaptive-thinking/src/index.ts",
        "-packages/pi-bible-verses/src/index.ts",
        "-packages/pi-byterover/src/index.ts",
        "-packages/pi-dap/src/index.ts",
        "-packages/pi-formatter/src/index.ts",
        "-packages/pi-git-checkpoints/src/index.ts",
        "-packages/pi-git-status-widget/src/index.ts",
        "-packages/pi-lsp/src/index.ts",
        "-packages/pi-minimal-subagents/src/index.ts",
        "-packages/pi-tps-tracker/src/index.ts"
      ]
    },
    {
      "source": "npm:@ian-pascoe/pi-bible-verses",
      "autoload": false,
      "extensions": [
        "-src/index.ts"
      ]
    },
    {
      "source": "npm:@ian-pascoe/pi-dap",
      "autoload": false,
      "extensions": [
        "-src/index.ts"
      ]
    },
    {
      "source": "npm:@ian-pascoe/pi-formatter",
      "autoload": false,
      "extensions": [
        "-src/index.ts"
      ]
    },
    {
      "source": "npm:@ian-pascoe/pi-git-checkpoints",
      "autoload": false,
      "extensions": [
        "-src/index.ts"
      ]
    },
    {
      "source": "npm:@ian-pascoe/pi-git-status-widget",
      "autoload": false,
      "extensions": [
        "-src/index.ts"
      ]
    },
    {
      "source": "npm:@ian-pascoe/pi-lsp",
      "autoload": false,
      "extensions": [
        "-src/index.ts"
      ]
    },
    {
      "source": "npm:@ian-pascoe/pi-minimal-subagents",
      "autoload": false,
      "extensions": [
        "-src/index.ts"
      ]
    },
    {
      "source": "npm:@ian-pascoe/pi-tps-tracker",
      "autoload": false,
      "extensions": [
        "-src/index.ts"
      ]
    }
  ],
  "formatter": {
    "formatters": {
      "oxfmt": {
        "command": "pnpm",
        "args": [
          "exec",
          "oxfmt",
          "--no-error-on-unmatched-pattern",
          "$FILE"
        ],
        "files": {
          "extensions": [
            ".js",
            ".jsx",
            ".ts",
            ".tsx",
            ".mjs",
            ".cjs",
            ".mts",
            ".cts",
            ".json",
            ".jsonc",
            ".md",
            ".yml",
            ".yaml",
            ".css"
          ]
        },
        "rootMarkers": [
          ".oxfmtrc.json",
          "package.json",
          ".git"
        ]
      }
    }
  },
  "dap": {
    "timeouts": {
      "startupMs": 10000,
      "requestMs": 10000,
      "executionMs": 30000,
      "shutdownMs": 5000
    },
    "adapters": {
      "node": {
        "command": "node",
        "args": [
          "packages/pi-dap/node_modules/vscode-js-debug/src/dapDebugServer.js",
          "$PORT",
          "127.0.0.1"
        ],
        "environment": {},
        "transport": {
          "type": "tcp",
          "host": "127.0.0.1",
          "port": 0
        }
      }
    },
    "profiles": {
      "node": {
        "adapter": "node",
        "arguments": {
          "type": "pwa-node",
          "console": "internalConsole",
          "stopOnEntry": true
        }
      }
    }
  },
  "lsp": {
    "servers": {
      "typescript": {
        "command": "pnpm",
        "args": [
          "exec",
          "tsc",
          "--lsp",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": [
          "tsconfig.json",
          "package.json",
          ".git"
        ]
      },
      "oxlint": {
        "command": "pnpm",
        "args": [
          "exec",
          "oxlint",
          "--lsp"
        ],
        "languages": [
          {
            "extensions": [
              ".js",
              ".mjs",
              ".cjs"
            ],
            "languageId": "javascript"
          },
          {
            "extensions": [
              ".jsx"
            ],
            "languageId": "javascriptreact"
          },
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": [
          ".oxlintrc.json",
          "package.json",
          ".git"
        ]
      }
    }
  }
}
