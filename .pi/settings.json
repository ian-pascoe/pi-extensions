{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-5-5",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode",
    "+tool_search",
    "+grep",
    "+find",
    "+ls"
  ],
  "packages": [
    {
      "source": "..",
      "autoload": false,
      "extensions": [
        "+packages/pi-advisor/src/index.ts",
        "+packages/pi-bible-verses/src/index.ts",
        "+packages/pi-command-deck/src/index.ts",
        "+packages/pi-context-management/src/index.ts",
        "+packages/pi-dap/src/index.ts",
        "+packages/pi-formatter/src/index.ts",
        "+packages/pi-git-checkpoints/src/index.ts",
        "+packages/pi-guardian/src/index.ts",
        "+packages/pi-lsp/src/index.ts",
        "+packages/pi-minimal-subagents/src/index.ts",
        "+packages/pi-skills-selector/src/index.ts",
        "+packages/pi-termctrl/src/index.ts",
        "+packages/pi-todo/src/index.ts",
        "+packages/pi-tps-tracker/src/index.ts",
        "+packages/pi-web-tools/src/index.ts"
      ],
      "skills": [
        "+packages/pi-advisor/skills/pi-advisor/SKILL.md",
        "+packages/pi-bible-verses/skills/pi-bible-verses/SKILL.md",
        "+packages/pi-command-deck/skills/pi-command-deck/SKILL.md",
        "+packages/pi-context-management/skills/pi-context-management/SKILL.md",
        "+packages/pi-dap/skills/pi-dap/SKILL.md",
        "+packages/pi-formatter/skills/pi-formatter/SKILL.md",
        "+packages/pi-git-checkpoints/skills/pi-git-checkpoints/SKILL.md",
        "+packages/pi-guardian/skills/pi-guardian/SKILL.md",
        "+packages/pi-lsp/skills/pi-lsp/SKILL.md",
        "+packages/pi-minimal-subagents/skills/pi-minimal-subagents/SKILL.md",
        "+packages/pi-skills-selector/skills/pi-skills-selector/SKILL.md",
        "+packages/pi-termctrl/skills/pi-termctrl/SKILL.md",
        "+packages/pi-todo/skills/pi-todo/SKILL.md",
        "+packages/pi-tps-tracker/skills/pi-tps-tracker/SKILL.md",
        "+packages/pi-web-tools/skills/pi-web-tools/SKILL.md"
      ]
    },
    {
      "source": "git:github.com/ian-pascoe/pi-extensions",
      "autoload": false,
      "extensions": [
        "-packages/pi-advisor/src/index.ts",
        "-packages/pi-bible-verses/src/index.ts",
        "-packages/pi-command-deck/src/index.ts",
        "-packages/pi-context-management/src/index.ts",
        "-packages/pi-dap/src/index.ts",
        "-packages/pi-formatter/src/index.ts",
        "-packages/pi-git-checkpoints/src/index.ts",
        "-packages/pi-guardian/src/index.ts",
        "-packages/pi-lsp/src/index.ts",
        "-packages/pi-minimal-subagents/src/index.ts",
        "-packages/pi-skills-selector/src/index.ts",
        "-packages/pi-termctrl/src/index.ts",
        "-packages/pi-todo/src/index.ts",
        "-packages/pi-tps-tracker/src/index.ts",
        "-packages/pi-web-tools/src/index.ts"
      ],
      "skills": [
        "-packages/pi-advisor/skills/pi-advisor/SKILL.md",
        "-packages/pi-bible-verses/skills/pi-bible-verses/SKILL.md",
        "-packages/pi-command-deck/skills/pi-command-deck/SKILL.md",
        "-packages/pi-context-management/skills/pi-context-management/SKILL.md",
        "-packages/pi-dap/skills/pi-dap/SKILL.md",
        "-packages/pi-formatter/skills/pi-formatter/SKILL.md",
        "-packages/pi-git-checkpoints/skills/pi-git-checkpoints/SKILL.md",
        "-packages/pi-guardian/skills/pi-guardian/SKILL.md",
        "-packages/pi-lsp/skills/pi-lsp/SKILL.md",
        "-packages/pi-minimal-subagents/skills/pi-minimal-subagents/SKILL.md",
        "-packages/pi-skills-selector/skills/pi-skills-selector/SKILL.md",
        "-packages/pi-termctrl/skills/pi-termctrl/SKILL.md",
        "-packages/pi-todo/skills/pi-todo/SKILL.md",
        "-packages/pi-tps-tracker/skills/pi-tps-tracker/SKILL.md",
        "-packages/pi-web-tools/skills/pi-web-tools/SKILL.md"
      ]
    }
  ],
  "guardian": {
    "enabled": true,
    "classifierModel": "typesafe/jev-latest",
    "model": "anthropic/claude-haiku-5-5",
    "thinkingLevel": "low"
  },
  "advisor": {
    "enabled": true,
    "model": "anthropic/claude-opus-5-5",
    "thinkingLevel": "high",
    "allowedTools": [
      "codemode",
      "context_history",
      "context_notes",
      "context_rollover",
      "find",
      "grep",
      "ls",
      "lsp_call_hierarchy",
      "lsp_diagnostics",
      "lsp_document_symbols",
      "lsp_find_references",
      "lsp_goto_definition",
      "lsp_goto_implementation",
      "lsp_goto_type_definition",
      "lsp_hover",
      "lsp_incoming_calls",
      "lsp_outgoing_calls",
      "lsp_status",
      "lsp_workspace_diagnostics",
      "lsp_workspace_symbols",
      "read",
      "tool_search",
      "web_fetch",
      "web_search"
    ]
  },
  "minimalSubagents": {
    "enabled": true,
    "baseToolset": ["codemode", "context_*", "tool_search"],
    "readToolset": [
      "find",
      "grep",
      "ls",
      "lsp_call_hierarchy",
      "lsp_diagnostics",
      "lsp_document_symbols",
      "lsp_find_references",
      "lsp_goto_definition",
      "lsp_goto_implementation",
      "lsp_goto_type_definition",
      "lsp_hover",
      "lsp_incoming_calls",
      "lsp_outgoing_calls",
      "lsp_status",
      "lsp_workspace_diagnostics",
      "lsp_workspace_symbols",
      "read",
      "web_fetch",
      "web_search"
    ],
    "modifyToolset": [
      "bash",
      "edit",
      "write",
      "lsp_rename",
      "lsp_code_actions",
      "lsp_apply",
      "lsp_format_document",
      "dap_*",
      "terminal_*"
    ],
    "modelRoles": {
      "small": {
        "model": "anthropic/claude-haiku-5-5",
        "hint": "Cheap and fast. Use for explore (locating code, tracing behavior, finding reusable patterns), web and docs research, summarizing, and mechanical edits. Medium thinking is usually enough."
      },
      "medium": {
        "model": "anthropic/claude-sonnet-5-5",
        "hint": "Default workhorse. Use for scoped implementation tasks with a settled approach, tests, refactors, and work that spans several concerns or fits no other tier."
      },
      "large": {
        "model": "anthropic/claude-opus-5-5",
        "hint": "Use for planning and design, independent correctness or spec review, and diagnosing failures. Use high thinking for plan and review; set xhigh thinking for debugging, regressions, and security audits."
      },
      "xlarge": {
        "model": "anthropic/claude-fable-5-1",
        "hint": "Most capable and most expensive. Use only when large has failed or the problem is unusually hard."
      }
    }
  },
  "formatter": {
    "formatters": {
      "oxfmt": {
        "command": "pnpm",
        "args": [
          "exec",
          "oxfmt",
          "--no-error-on-unmatched-pattern",
          "$FILE"
        ],
        "files": {
          "extensions": [
            ".js",
            ".jsx",
            ".ts",
            ".tsx",
            ".mjs",
            ".cjs",
            ".mts",
            ".cts",
            ".json",
            ".jsonc",
            ".md",
            ".yml",
            ".yaml",
            ".css"
          ]
        },
        "rootMarkers": [
          ".oxfmtrc.json"
        ],
        "requireRootMarker": true
      }
    }
  },
  "dap": {
    "adapters": {
      "node": {
        "command": "node",
        "args": [
          "tools/pi-dap-vscode-js-debug/node_modules/vscode-js-debug/src/dapDebugServer.js",
          "$PORT",
          "127.0.0.1"
        ],
        "environment": {},
        "transport": {
          "type": "tcp",
          "host": "127.0.0.1",
          "port": 0
        }
      }
    },
    "profiles": {
      "node": {
        "adapter": "node",
        "arguments": {
          "type": "pwa-node",
          "console": "internalConsole"
        }
      }
    }
  },
  "lsp": {
    "servers": {
      "typescript": {
        "command": "pnpm",
        "args": [
          "--workspace-root",
          "exec",
          "tsc",
          "--lsp",
          "--stdio"
        ],
        "languages": [
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": [
          "tsconfig.json"
        ],
        "workspaceRootMarkers": [
          "pnpm-workspace.yaml"
        ],
        "requireRootMarker": true
      },
      "oxlint": {
        "command": "pnpm",
        "args": [
          "exec",
          "oxlint",
          "--lsp"
        ],
        "languages": [
          {
            "extensions": [
              ".js",
              ".mjs",
              ".cjs"
            ],
            "languageId": "javascript"
          },
          {
            "extensions": [
              ".jsx"
            ],
            "languageId": "javascriptreact"
          },
          {
            "extensions": [
              ".ts",
              ".mts",
              ".cts"
            ],
            "languageId": "typescript"
          },
          {
            "extensions": [
              ".tsx"
            ],
            "languageId": "typescriptreact"
          }
        ],
        "rootMarkers": [
          ".oxlintrc.json"
        ],
        "requireRootMarker": true
      }
    }
  }
}
