{
  "name": "@ian-pascoe/pi-tool-installer",
  "version": "0.1.0",
  "private": false,
  "description": "Private managed tool installation shared by Pi language extensions",
  "keywords": [
    "language-tools",
    "mise",
    "pi"
  ],
  "homepage": "https://github.com/ian-pascoe/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/ian-pascoe/pi-extensions/issues"
  },
  "license": "MIT",
  "author": "Ian Pascoe <ian.g.pascoe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ian-pascoe/pi-extensions.git",
    "directory": "packages/pi-tool-installer"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "typebox": "^1.3.28"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
