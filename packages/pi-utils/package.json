{
  "name": "@ian-pascoe/pi-utils",
  "version": "0.1.0",
  "private": false,
  "description": "Shared runtime utilities for Ian Pascoe's Pi extensions",
  "keywords": [
    "pi",
    "terminal",
    "utilities"
  ],
  "homepage": "https://github.com/ian-pascoe/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/ian-pascoe/pi-extensions/issues"
  },
  "license": "MIT",
  "author": "Ian Pascoe <ian.g.pascoe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ian-pascoe/pi-extensions.git",
    "directory": "packages/pi-utils"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "pnpm build && vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
