{
  "name": "@ian-pascoe/pi-utils",
  "version": "0.3.1",
  "private": false,
  "description": "Shared runtime utilities for Ian Pascoe's Pi extensions",
  "keywords": [
    "pi",
    "terminal",
    "utilities"
  ],
  "homepage": "https://github.com/ian-pascoe/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/ian-pascoe/pi-extensions/issues"
  },
  "license": "MIT",
  "author": "Ian Pascoe <ian.g.pascoe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ian-pascoe/pi-extensions.git",
    "directory": "packages/pi-utils"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pi-agent-session-discovery": "./src/pi-agent-session-discovery.ts",
    "./locked-file-update": "./src/locked-file-update.ts",
    "./layered-settings": "./src/layered-settings.ts",
    "./evidence": "./src/evidence.ts",
    "./settings-menu": "./src/settings-menu.ts",
    "./settings-command": "./src/settings-command.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./pi-agent-session-discovery": {
        "types": "./dist/pi-agent-session-discovery.d.ts",
        "import": "./dist/pi-agent-session-discovery.js"
      },
      "./locked-file-update": {
        "types": "./dist/locked-file-update.d.ts",
        "import": "./dist/locked-file-update.js"
      },
      "./layered-settings": {
        "types": "./dist/layered-settings.d.ts",
        "import": "./dist/layered-settings.js"
      },
      "./evidence": {
        "types": "./dist/evidence.d.ts",
        "import": "./dist/evidence.js"
      },
      "./settings-menu": {
        "types": "./dist/settings-menu.d.ts",
        "import": "./dist/settings-menu.js"
      },
      "./settings-command": {
        "types": "./dist/settings-command.d.ts",
        "import": "./dist/settings-command.js"
      }
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
