{
  "name": "@ian-pascoe/pi-codemode",
  "version": "0.6.5",
  "private": false,
  "description": "Process-isolated persistent TypeScript tool composition for Pi",
  "keywords": [
    "codemode",
    "deno",
    "pi",
    "pi-extension",
    "pi-package",
    "typescript"
  ],
  "homepage": "https://github.com/ian-pascoe/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/ian-pascoe/pi-extensions/issues"
  },
  "license": "MIT",
  "author": "Ian Pascoe <ian.g.pascoe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ian-pascoe/pi-extensions.git",
    "directory": "packages/pi-codemode"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "deno": "2.9.6",
    "minimatch": "^10.2.6",
    "runtime-typescript": "npm:typescript@6.0.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@howaboua/pi-codex-conversion": "3.0.25"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@howaboua/pi-codex-conversion": "3.0.25",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@howaboua/pi-codex-conversion": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
