{
  "name": "@ian-pascoe/pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Ian Pascoe's Pi Extensions",
  "license": "MIT",
  "author": "Ian Pascoe <ian.g.pascoe@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "git-install:check": "node scripts/check-git-install.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:staged": "lint-staged",
    "pack:check": "node scripts/check-package-packs.mjs",
    "prepare": "node scripts/prepare.mjs",
    "publish-packages": "changeset publish",
    "test": "turbo run test test:root",
    "test:root": "vitest run",
    "typecheck": "turbo run typecheck:root typecheck",
    "typecheck:root": "tsc --noEmit",
    "verify": "turbo run format:check lint typecheck:root typecheck test test:root --output-logs=errors-only",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@oxlint/plugins": "^1.86.0",
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.99.0",
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0",
    "typebox": "*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./packages/pi-command-deck/src/index.ts",
      "./packages/pi-minimal-subagents/src/index.ts",
      "./packages/pi-bible-verses/src/index.ts",
      "./packages/pi-tps-tracker/src/index.ts",
      "./packages/pi-git-checkpoints/src/index.ts",
      "./packages/pi-formatter/src/index.ts",
      "./packages/pi-lsp/src/index.ts",
      "./packages/pi-dap/src/index.ts",
      "./packages/pi-web-tools/src/index.ts",
      "./packages/pi-todo/src/index.ts",
      "./packages/pi-context-management/src/index.ts",
      "./packages/pi-skills-selector/src/index.ts",
      "./packages/pi-advisor/src/index.ts",
      "./packages/pi-termctrl/src/index.ts"
    ],
    "skills": [
      "./packages/pi-command-deck/skills",
      "./packages/pi-minimal-subagents/skills",
      "./packages/pi-bible-verses/skills",
      "./packages/pi-tps-tracker/skills",
      "./packages/pi-git-checkpoints/skills",
      "./packages/pi-formatter/skills",
      "./packages/pi-lsp/skills",
      "./packages/pi-dap/skills",
      "./packages/pi-web-tools/skills",
      "./packages/pi-todo/skills",
      "./packages/pi-context-management/skills",
      "./packages/pi-skills-selector/skills",
      "./packages/pi-advisor/skills",
      "./packages/pi-termctrl/skills"
    ]
  }
}
